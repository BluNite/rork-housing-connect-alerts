# Copy this file to .env and fill in real values. Never commit .env.

# Rork platform variables (provided by the Rork runtime — do not edit values here)
EXPO_PUBLIC_RORK_TOOLKIT_SECRET_KEY=
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_RORK_AUTH_URL=
EXPO_PUBLIC_RORK_API_BASE_URL=
EXPO_PUBLIC_RORK_FUNCTIONS_URL=
EXPO_PUBLIC_TOOLKIT_URL=
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_TEAM_ID=

# Server-side only — used by edge functions via Supabase secrets, never by the browser.
# Sync with: supabase secrets set STRIPE_SECRET_KEY=sk_live_... STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=sk_test_or_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
